{
  "type": "json_schema",
  "name": "catalog_assess_v1",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "assessments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fact_id": {"type": "string", "minLength": 1},
            "status": {"type": "string", "enum": ["supported", "uncertain", "not_supported"]},
            "evidence_quotes": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "reason": {"type": "string", "minLength": 1}
          },
          "required": ["fact_id", "status", "evidence_quotes", "reason"]
        }
      }
    },
    "required": ["assessments"]
  }
}
