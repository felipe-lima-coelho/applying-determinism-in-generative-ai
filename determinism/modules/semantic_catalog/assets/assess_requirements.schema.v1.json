{
  "type": "json_schema",
  "name": "catalog_assess_requirements_v1",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "assessments": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fact_id": {"type": "string", "minLength": 1},
            "reference_status": {"type": "string", "enum": ["compatible", "ambiguous", "different"]},
            "requirements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "requirement_id": {"type": "string", "minLength": 1},
                  "status": {"type": "string", "enum": ["entailed", "absent", "contradicted", "ambiguous"]},
                  "evidence_quotes": {"type": "array", "items": {"type": "string", "minLength": 1}}
                },
                "required": ["requirement_id", "status", "evidence_quotes"]
              }
            }
          },
          "required": ["fact_id", "reference_status", "requirements"]
        }
      }
    },
    "required": ["assessments"]
  }
}
