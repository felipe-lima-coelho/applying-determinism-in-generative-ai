{
  "type": "json_schema",
  "name": "catalog_extract_v1",
  "strict": true,
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "facts": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "statement": {"type": "string", "minLength": 1},
            "evidence_quotes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "information_indices": {"type": "array", "items": {"type": "integer", "minimum": 0}}
          },
          "required": ["statement", "evidence_quotes", "information_indices"]
        }
      }
    },
    "required": ["facts"]
  }
}
